# Copy to .env.local for local development, and set the same two values as
# environment variables in Vercel.
#
# Anything prefixed VITE_ is compiled into the JavaScript the browser downloads,
# so the API key below is visible to anyone who opens this page. That is
# unavoidable for a static page calling a key-protected API directly, and the
# assessment asks for the key. A production build would put a small server in
# between that holds the key and never ships it to the browser.

VITE_API_BASE_URL=https://your-api.onrender.com
VITE_API_KEY=your-api-key
